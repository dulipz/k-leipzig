---
// Detailseite je Produktion: Plakat, Beschreibung, Besetzung, Szenenfotos und Termine.
import { getCollection, getEntry, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Galerie from '../../components/Galerie.astro';
import TerminRow from '../../components/TerminRow.astro';
import { plakate, galerien } from '../../lib/produktion-medien';
import { typBadge, type Typ } from '../../lib/format';

export async function getStaticPaths() {
  const produktionen = await getCollection('produktionen');
  return produktionen.map((p) => ({ params: { id: p.id }, props: { produktion: p } }));
}

const { produktion } = Astro.props;
const { Content } = await render(produktion);
const d = produktion.data;
const id = produktion.id;
const titelText = d.titel.replace(/<[^>]+>/g, '');
const plakat = plakate[id];
const galerie = galerien[id];
const badge = d.typ === 'theater' ? null : typBadge(d.typ);
const istGastspiel = d.reihenfolge >= 20;

// Kommende Termine dieser Produktion
const heute = new Date();
heute.setHours(0, 0, 0, 0);
const termine = (await getCollection('termine'))
  .filter((t) => t.data.produktion.id === id)
  .map((t) => ({ ...t.data, id: t.id, time: new Date(t.data.datum + 'T00:00:00').getTime() }))
  .filter((t) => t.time >= heute.getTime())
  .sort((a, b) => a.time - b.time);

// Weitere Stücke (ohne Gastspiele) als Querverweis
const weitere = (await getCollection('produktionen'))
  .filter((p) => p.id !== id && p.data.reihenfolge < 20)
  .sort((a, b) => a.data.reihenfolge - b.data.reihenfolge);
---

<BaseLayout
  title={`${titelText} — ${d.untertitel} · Komödie Leipzig`}
  description={`${titelText} (${d.untertitel}) – Termine, Besetzung und Szenenfotos. Komödie Leipzig in der Kleinen Komödie Reuden.`}
>
  <section class="block stueck">
    <div class="container">
      <a class="zurueck" href="/#programm">← Zurück zum Programm</a>

      <div class="s-grid">
        <div class="s-plakat">
          {plakat ? (
            <img src={plakat} alt={`Plakat: ${titelText}`} />
          ) : (
            <div class="s-plakat-leer"><span>Plakat folgt</span></div>
          )}
        </div>

        <div class="s-text">
          <div class="kick">{istGastspiel ? 'Gastspiel' : d.untertitel}</div>
          <h1 set:html={d.titel} />
          {istGastspiel && <p class="s-unter">{d.untertitel}</p>}
          <div class="s-meta">
            {badge && <span class={`badge ${badge.cls}`}>{badge.label}</span>}
            <span class="s-preis">Tickets ab {d.preisAb},– €</span>
          </div>

          <div class="s-beschreibung">
            <Content />
          </div>

          <div class="s-cta">
            <a href={`/spielplan?stueck=${id}`} class="btn btn-amber">Termine &amp; Karten →</a>
            <a href="/#gutschein-anfragen" class="btn btn-ghost" data-gutschein>Gutschein verschenken</a>
          </div>

          {(d.regie || d.besetzung.length > 0) && (
            <div class="s-besetzung">
              <h2>Besetzung</h2>
              <dl>
                {d.regie && (
                  <div class="b-zeile"><dt>Buch, Bühne &amp; Regie</dt><dd>{d.regie}</dd></div>
                )}
                {d.besetzung.map((b) => (
                  <div class="b-zeile"><dt>{b.rolle}</dt><dd>{b.name}</dd></div>
                ))}
              </dl>
            </div>
          )}
          {d.hinweise && <p class="s-hinweise">{d.hinweise}</p>}
        </div>
      </div>
    </div>
  </section>

  {galerie && (
    <section class="block band" id="szenenfotos">
      <div class="container">
        <Galerie slug={galerie} titel="Szenenfotos" untertitel={`Bilder von der Bühne – ${titelText}`} />
      </div>
    </section>
  )}

  <section class="block" id="termine">
    <div class="container">
      <div class="head">
        <div>
          <div class="kick">Termine &amp; Tickets</div>
          <h2>Nächste Vorstellungen</h2>
        </div>
        {termine.length > 0 && <a class="more" href={`/spielplan?stueck=${id}`}>Alle Termine →</a>}
      </div>
      {termine.length > 0 ? (
        <div class="termine">
          {termine.slice(0, 6).map((t) => (
            <TerminRow
              datum={t.datum}
              uhrzeit={t.uhrzeit}
              status={t.status}
              ticketUrl={t.ticketUrl ?? `/spielplan?stueck=${id}`}
              titel={titelText}
              untertitel={d.untertitel}
              typ={(t.art ?? d.typ) as Typ}
              ort={t.ort}
              preis={t.preis}
            />
          ))}
        </div>
      ) : (
        <p class="s-keine">
          Aktuell sind für dieses Stück keine Termine eingetragen. Rufen Sie uns gern an:
          <a href="tel:+491791437331">0179 1437331</a>.
        </p>
      )}
    </div>
  </section>

  {weitere.length > 0 && (
    <section class="block band">
      <div class="container">
        <div class="head"><div><div class="kick">Unser Programm</div><h2>Weitere Stücke</h2></div></div>
        <div class="weitere">
          {weitere.map((p) => (
            <a href={`/programm/${p.id}`} class="w-item">
              <span
                class="w-bild"
                style={plakate[p.id] ? `background-image:url('${plakate[p.id]}')` : undefined}
              ></span>
              <span class="w-titel" set:html={p.data.titel} />
              <span class="w-unter">{p.data.untertitel}</span>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- LIGHTBOX für die Szenenfotos -->
  {galerie && (
    <div class="lightbox" id="lightbox" hidden role="dialog" aria-modal="true" aria-label="Bildansicht">
      <button class="lb-close" type="button" aria-label="Schließen">×</button>
      <button class="lb-nav lb-prev" type="button" aria-label="Vorheriges Bild">‹</button>
      <img class="lb-img" src="" alt="" />
      <button class="lb-nav lb-next" type="button" aria-label="Nächstes Bild">›</button>
    </div>
  )}
</BaseLayout>

<style>
  .zurueck { display: inline-block; color: var(--amber); font-weight: 700; font-size: 15px; margin-bottom: 26px; }
  .zurueck:hover { text-decoration: underline; }

  .s-grid { display: grid; grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr); gap: 48px; align-items: start; }
  .s-plakat { position: sticky; top: 104px; }
  .s-plakat img { width: 100%; height: auto; display: block; border-radius: 18px; box-shadow: var(--shadow); border: 1px solid var(--line); }
  .s-plakat-leer { aspect-ratio: 3 / 4; border-radius: 18px; border: 1px solid var(--line); display: flex; align-items: center; justify-content: center; background: linear-gradient(160deg, var(--wine-soft), var(--wine-deep)); color: var(--cream-dim); letter-spacing: .12em; text-transform: uppercase; font-size: 13px; }

  .s-text .kick { color: var(--amber); font-weight: 700; letter-spacing: .18em; text-transform: uppercase; font-size: 13px; margin-bottom: 10px; }
  .s-text h1 { font-family: var(--display); font-weight: 900; font-size: clamp(34px, 5vw, 56px); line-height: 1.02; }
  .s-unter { color: var(--cream-dim); font-size: 18px; margin-top: 8px; }
  .s-meta { display: flex; gap: 14px; align-items: center; flex-wrap: wrap; margin: 18px 0 22px; }
  .s-preis { font-weight: 700; color: var(--cream); }
  .s-beschreibung { color: var(--cream-dim); font-size: 17.5px; line-height: 1.7; }
  .s-beschreibung :global(p) { margin-bottom: 14px; }
  .s-beschreibung :global(strong) { color: var(--cream); }
  .s-cta { display: flex; gap: 12px; flex-wrap: wrap; margin: 26px 0 8px; }

  .s-besetzung { margin-top: 36px; border-top: 1px solid var(--line); padding-top: 26px; }
  .s-besetzung h2 { font-family: var(--display); font-weight: 900; font-size: 26px; margin-bottom: 14px; }
  .s-besetzung dl { display: grid; gap: 0; }
  .b-zeile { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; padding: 10px 0; border-bottom: 1px dashed var(--line); }
  .b-zeile dt { color: var(--cream-dim); font-size: 15.5px; }
  .b-zeile dd { color: var(--cream); font-weight: 600; font-size: 15.5px; }
  .s-hinweise { margin-top: 18px; font-size: 13.5px; color: var(--cream-dim); opacity: .8; font-style: italic; }
  .s-keine { color: var(--cream-dim); }
  .s-keine a { color: var(--amber); font-weight: 700; }

  .weitere { display: grid; grid-template-columns: repeat(auto-fill, minmax(150px, 1fr)); gap: 16px; }
  .w-item { display: flex; flex-direction: column; gap: 4px; }
  .w-bild { display: block; aspect-ratio: 3 / 4; border-radius: 12px; border: 1px solid var(--line); background: linear-gradient(160deg, var(--wine-soft), var(--wine-deep)) center / cover; margin-bottom: 6px; transition: transform .2s, border-color .2s; }
  .w-item:hover .w-bild { transform: translateY(-4px); border-color: rgba(244, 161, 77, .5); }
  .w-titel { font-family: var(--display); font-weight: 700; font-size: 16px; line-height: 1.15; }
  .w-unter { font-size: 13px; color: var(--cream-dim); }

  @media (max-width: 900px) {
    .s-grid { grid-template-columns: 1fr; gap: 30px; }
    .s-plakat { position: static; max-width: 420px; margin: 0 auto; width: 100%; }
  }
  @media (max-width: 680px) {
    .s-text { text-align: center; }
    .s-meta, .s-cta { justify-content: center; }
    .s-cta .btn { width: 100%; justify-content: center; }
    .b-zeile { grid-template-columns: 1fr; gap: 2px; text-align: left; }
    .s-besetzung h2 { text-align: center; }
    .weitere { display: flex; overflow-x: auto; scroll-snap-type: x mandatory; scrollbar-width: none; }
    .weitere::-webkit-scrollbar { display: none; }
    .w-item { flex: 0 0 42%; scroll-snap-align: start; }
  }

  /* Lightbox */
  .lightbox { position: fixed; inset: 0; z-index: 60; display: flex; align-items: center; justify-content: center; background: rgba(14,4,10,.93); padding: 24px; }
  .lightbox[hidden] { display: none; }
  .lb-img { max-width: min(1200px, 94vw); max-height: 88vh; border-radius: 10px; box-shadow: var(--shadow); }
  .lb-close, .lb-nav { position: absolute; background: rgba(0,0,0,.42); color: var(--cream); border: 1px solid var(--line); cursor: pointer; border-radius: 999px; line-height: 1; display: flex; align-items: center; justify-content: center; transition: background .2s, color .2s; }
  .lb-close { top: 18px; right: 18px; width: 46px; height: 46px; font-size: 28px; }
  .lb-nav { top: 50%; transform: translateY(-50%); width: 54px; height: 54px; font-size: 34px; }
  .lb-prev { left: 18px; }
  .lb-next { right: 18px; }
  .lb-close:hover, .lb-nav:hover { background: var(--amber); color: var(--wine-deep); }
  @media (max-width: 640px) { .lb-nav { width: 44px; height: 44px; font-size: 28px; } }
</style>

<script>
  // Lightbox für die Szenenfotos
  const lb = document.getElementById('lightbox');
  if (lb) {
    const lbImg = lb.querySelector('.lb-img') as HTMLImageElement;
    const items = Array.from(document.querySelectorAll('.g-item'));
    const urls = items.map((el) => el.getAttribute('data-full') || '');
    let cur = -1;
    const show = (n: number) => {
      cur = (n + urls.length) % urls.length;
      lbImg.setAttribute('src', urls[cur]);
      lb.hidden = false;
      document.body.style.overflow = 'hidden';
    };
    const close = () => {
      lb.hidden = true;
      lbImg.setAttribute('src', '');
      document.body.style.overflow = '';
    };
    items.forEach((el, i) => el.addEventListener('click', () => show(i)));
    lb.querySelector('.lb-close')?.addEventListener('click', close);
    lb.querySelector('.lb-prev')?.addEventListener('click', () => show(cur - 1));
    lb.querySelector('.lb-next')?.addEventListener('click', () => show(cur + 1));
    lb.addEventListener('click', (e) => { if (e.target === lb) close(); });
    document.addEventListener('keydown', (e) => {
      if (lb.hidden) return;
      if (e.key === 'Escape') close();
      else if (e.key === 'ArrowLeft') show(cur - 1);
      else if (e.key === 'ArrowRight') show(cur + 1);
    });
  }
</script>
