---
// Interne Seite für die Kasse: Vorstellungen mit einem Tipp auf "Ausverkauft" setzen.
// Nicht verlinkt, nicht in Suchmaschinen. Ein gemeinsames Passwort.
import '@fontsource-variable/fraunces/opsz.css';
import '@fontsource-variable/libre-franklin/index.css';
import { getCollection } from 'astro:content';
import { COOKIE, getEnv, sessionGueltig, termineLesen, terminKey, heuteBerlin, SPAETESTES_DATUM, WARNUNG_JAHRE } from '../../lib/sinahamala';
import { plakatVon } from '../../lib/produktion-medien';

export const prerender = false;

Astro.response.headers.set('Cache-Control', 'no-store');
Astro.response.headers.set('X-Robots-Tag', 'noindex, nofollow');

const env = getEnv(Astro.locals);
const angemeldet = await sessionGueltig(env, Astro.cookies.get(COOKIE)?.value);
const fehler = Astro.url.searchParams.get('fehler');

let items: any[] = [];
let stuecke: { id: string; t: string; typ: string; p: number; u: string; r: number; img: string | null; text: string; k: number }[] = [];
let orte: string[] = [];
let ladeFehler = '';
if (angemeldet) {
  try {
    const prods = (await getCollection('produktionen')).sort((a, b) => (a.data as any).reihenfolge - (b.data as any).reihenfolge);
    const titel = new Map(prods.map((p) => [p.id, ((p.data as any).titel as string).replace(/<[^>]+>/g, ' ').replace(/\s+/g, ' ').trim()]));
    stuecke = prods.map((p) => ({
      id: p.id, t: titel.get(p.id)!, typ: (p.data as any).typ, p: (p.data as any).preisAb,
      u: (p.data as any).untertitel ?? '', r: (p.data as any).reihenfolge ?? 99,
      img: plakatVon(p.id, p.data as any) ?? null, text: (p.body ?? '').trim(), k: 0,
    }));
    const { termine } = await termineLesen(env);
    // Spielorte nach Häufigkeit – als Vorschläge im Formular
    const zaehler = new Map<string, number>();
    termine.forEach((t) => t.ort && zaehler.set(t.ort, (zaehler.get(t.ort) ?? 0) + 1));
    orte = [...zaehler.entries()].sort((a, b) => b[1] - a[1]).map(([o]) => o);
    const heuteK = heuteBerlin();
    stuecke.forEach((s) => (s.k = termine.filter((t) => t.produktion === s.id && t.datum >= heuteK).length));
    const heute = heuteBerlin();
    items = termine
      .map((t, idx) => ({
        idx,
        key: terminKey(t),
        d: t.datum,
        u: t.uhrzeit,
        t: titel.get(t.produktion) ?? t.produktion,
        o: t.ort ?? '',
        a: t.art ?? 'theater',
        s: t.status ?? 'verfuegbar',
        p: typeof t.plaetze === 'number' ? t.plaetze : null,
      }))
      .filter((x) => x.d >= heute)
      .sort((a, b) => (a.d + a.u).localeCompare(b.d + b.u));
  } catch (e) {
    ladeFehler = e instanceof Error ? e.message : 'Spielplan konnte nicht geladen werden.';
  }
}
const daten = JSON.stringify({ items, heute: heuteBerlin(), bis: SPAETESTES_DATUM, warnJahre: WARNUNG_JAHRE, stuecke, orte }).replace(/</g, '\\u003c');
---
<!doctype html>
<html lang="de">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <meta name="robots" content="noindex, nofollow" />
  <meta name="theme-color" content="#2c0d20" />
  <title>Kasse & Spielplan · Komödie Leipzig</title>
</head>
<body>
  {!angemeldet ? (
    <main class="login">
      <form method="post" action="/sinahamala/login" class="login-box">
        <small class="kick">Komödie Leipzig · intern</small>
        <h1>Ausverkauft-Schalter</h1>
        <label for="pw">Passwort</label>
        <input id="pw" name="passwort" type="password" autocomplete="current-password" required autofocus />
        {fehler === '1' && <p class="err">Das Passwort stimmt nicht. Bitte noch einmal versuchen.</p>}
        {fehler === 'setup' && <p class="err">Der Login ist noch nicht eingerichtet (SINAHAMALA_PASSWORD fehlt).</p>}
        <button type="submit">Anmelden</button>
      </form>
    </main>
  ) : (
    <>
      <div class="wrap">
        <header>
          <div class="top">
            <div class="brand"><small class="kick">Komödie Leipzig · intern</small><h1>Kasse &amp; Spielplan</h1></div>
            <form method="post" action="/sinahamala/logout"><button class="logout" type="submit">Abmelden</button></form>
          </div>
          <nav class="tabs" role="tablist" aria-label="Bereiche">
            <button class="tab" role="tab" data-tab="schalter" aria-selected="true">Ausverkauft</button>
            <button class="tab" role="tab" data-tab="termine" aria-selected="false">Termine eintragen</button>
            <button class="tab" role="tab" data-tab="stueck" aria-selected="false">Stücke</button>
          </nav>
          <div class="filterbar" data-panel="schalter">
          <input id="q" class="search" type="search" placeholder="Stück, Ort oder Datum suchen …" autocomplete="off" />
          <div class="chips" role="group" aria-label="Filter">
            <button class="chip" data-f="alle" aria-pressed="true">Alle</button>
            <button class="chip" data-f="woche" aria-pressed="false">Nächste 7 Tage</button>
            <button class="chip" data-f="reuden" aria-pressed="false">Kleine Komödie Reuden</button>
            <button class="chip" data-f="dinner" aria-pressed="false">Dinner-Shows</button>
            <button class="chip" data-f="sold" aria-pressed="false">Nur ausverkaufte</button>
          </div>
          </div>
        </header>
        {ladeFehler && <p class="err big">{ladeFehler}</p>}
        <div data-panel="schalter">
          <main id="out"></main>
          <p class="hint"><b>Freie Plätze:</b> Zahl eintragen und bei jeder Bestellung mit − verringern. Bei 0 wird die Vorstellung automatisch ausverkauft. Leer lassen = nicht zählen.<br />Änderungen werden nach 2 Sekunden gespeichert und erscheinen nach ca. 2 Minuten auf der Website.</p>
        </div>

        <!-- TERMINE EINTRAGEN -->
        <form id="f-termine" class="panel" data-panel="termine" hidden novalidate>
          <h2>Neue Vorstellungen eintragen</h2>
          <p class="lead">Termine können ab heute beliebig weit im Voraus eingetragen werden.</p>
          <label class="fld"><span>Stück</span>
            <select id="t-stueck" required></select>
          </label>
          <label class="fld"><span>Spielort</span>
            <input id="t-ort" list="orte" required value="Kleine Komödie, Reuden an der Fuhne" autocomplete="off" />
            <datalist id="orte"></datalist>
          </label>
          <div class="pair">
            <label class="fld"><span>Art</span>
              <select id="t-art"><option value="theater">Theaterabend</option><option value="dinner">Dinner-Show</option></select>
            </label>
            <label class="fld"><span>Preis pro Person (€)</span>
              <input id="t-preis" type="number" min="0" max="999" step="0.5" inputmode="decimal" placeholder="leer = auf Anfrage" />
            </label>
          </div>
          <div class="fld"><span>Datum &amp; Uhrzeit</span>
            <div id="t-rows" class="dates"></div>
            <button type="button" id="t-add" class="ghost">+ weiteres Datum</button>
          </div>
          <p class="err" id="t-err" hidden></p>
          <button type="submit" class="primary" id="t-save">Termine speichern</button>
          <p class="hint">Neue Termine erscheinen nach ca. 2 Minuten auf der Website und hier im Ausverkauft-Schalter.</p>
        </form>

        <!-- STÜCKE: Liste, Neu, Bearbeiten, Löschen -->
        <div data-panel="stueck" hidden>
        <section class="panel" id="s-uebersicht">
          <div class="panel-head">
            <h2>Stücke</h2>
            <button type="button" class="primary small" id="s-neu">+ Neues Stück</button>
          </div>
          <div id="s-liste" class="s-liste"></div>
          <p class="hint">Änderungen erscheinen nach ca. 2 Minuten auf der Website.</p>
        </section>
        <form id="f-stueck" class="panel" hidden novalidate>
          <div class="panel-head">
            <h2 id="s-h2">Neues Stück anlegen</h2>
            <button type="button" class="ghost" id="s-abbrechen">Abbrechen</button>
          </div>
          <p class="lead" id="s-lead">Danach unter „Termine eintragen“ die Vorstellungen hinzufügen.</p>
          <label class="fld"><span>Titel</span>
            <input id="s-titel" required maxlength="80" placeholder="z. B. Der Hauptmann von Köpenick" />
          </label>
          <label class="fld"><span>Genre-Zeile</span>
            <input id="s-unter" required maxlength="80" placeholder="z. B. Gauner-Komödie" />
          </label>
          <div class="pair">
            <label class="fld"><span>Art</span>
              <select id="s-typ"><option value="theater">Theaterabend</option><option value="dinner">Dinner-Show</option><option value="familie">Familienstück</option></select>
            </label>
            <label class="fld"><span>Preis ab (€)</span>
              <input id="s-preis" type="number" min="0" max="999" step="1" inputmode="numeric" value="34" required />
            </label>
          </div>
          <div class="fld"><span>Plakat (Bild vom Computer)</span>
            <label class="drop" id="s-drop">
              <input id="s-bild" type="file" accept="image/jpeg,image/png,image/webp" />
              <img id="s-vorschau" alt="" hidden />
              <span id="s-droptext">Bild auswählen oder hierher ziehen<small>JPG oder PNG, Hochformat (3:4)</small></span>
            </label>
          </div>
          <label class="fld"><span>Beschreibung <i>(optional)</i></span>
            <textarea id="s-text" rows="6" maxlength="6000" placeholder="Worum geht es? Absätze mit einer Leerzeile trennen."></textarea>
          </label>
          <label class="check"><input id="s-start" type="checkbox" checked /> Auf der Startseite unter „Was bei uns gespielt wird“ zeigen</label>
          <p class="err" id="s-err" hidden></p>
          <button type="submit" class="primary" id="s-save">Stück anlegen</button>
          <p class="hint">Erscheint nach ca. 2 Minuten auf der Website. Regie, Besetzung und Hinweise werden im Redaktions-Backend (Keystatic) gepflegt und bleiben beim Bearbeiten hier unverändert.</p>
        </form>
        </div>
      </div>
      <div class="toast" id="toast" role="status" aria-live="polite">
        <p id="tmsg"></p><button id="undo" type="button">Rückgängig</button>
      </div>
      <script type="application/json" id="sh-data" set:html={daten}></script>
    </>
  )}
</body>
</html>

<script>
  const el = document.getElementById('sh-data');
  if (el) {
    type Item = { idx: number; key: string; d: string; u: string; t: string; o: string; a: string; s: string; p: number | null };
    const { items, heute } = JSON.parse(el.textContent || '{}') as { items: Item[]; heute: string };
    (window as any).__zeige = (html: string, fehler = false) => zeige(html, false, fehler);
    const WD = ['So', 'Mo', 'Di', 'Mi', 'Do', 'Fr', 'Sa'];
    const MON = ['Januar', 'Februar', 'März', 'April', 'Mai', 'Juni', 'Juli', 'August', 'September', 'Oktober', 'November', 'Dezember'];
    let filter = 'alle', query = '';
    let last: { item: Item; prev: string } | null = null;
    let timer: number | undefined;
    const out = document.getElementById('out')!;
    const toast = document.getElementById('toast')!;
    const tmsg = document.getElementById('tmsg')!;
    const undoBtn = document.getElementById('undo') as HTMLButtonElement;
    const esc = (s: string) => s.replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]!));
    const dt = (s: string) => { const [y, m, d] = s.split('-').map(Number); return new Date(y, m - 1, d); };
    const kurz = (x: Item) => { const d = dt(x.d); return `${d.getDate()}.${d.getMonth() + 1}.`; };
    const bis7 = (() => { const d = dt(heute); d.setDate(d.getDate() + 7); return d; })();
    const pending = new Set<number>();

    function visible(x: Item) {
      if (filter === 'woche' && dt(x.d) > bis7) return false;
      if (filter === 'reuden' && !/Reuden/.test(x.o)) return false;
      if (filter === 'dinner' && x.a !== 'dinner') return false;
      if (filter === 'sold' && x.s !== 'ausverkauft') return false;
      if (query) {
        const d = dt(x.d);
        const hay = `${x.t} ${x.o} ${d.getDate()}.${d.getMonth() + 1}. ${String(d.getDate()).padStart(2, '0')}.${String(d.getMonth() + 1).padStart(2, '0')}. ${MON[d.getMonth()]}`.toLowerCase();
        if (!query.split(/\s+/).every((w) => hay.includes(w))) return false;
      }
      return true;
    }

    function render() {
      const list = items.filter(visible);
      if (!list.length) {
        out.innerHTML = `<p class="empty">${items.length ? 'Keine Vorstellung gefunden. Suchbegriff oder Filter ändern.' : 'Keine kommenden Vorstellungen eingetragen.'}</p>`;
        return;
      }
      const groups: Record<string, Item[]> = {};
      list.forEach((x) => (groups[x.d.slice(0, 7)] ||= []).push(x));
      out.innerHTML = Object.entries(groups).map(([k, arr]) => {
        const sold = arr.filter((x) => x.s === 'ausverkauft').length;
        return `<div class="month">${MON[Number(k.slice(5, 7)) - 1]} ${k.slice(0, 4)}<span>${arr.length} Vorstellungen · ${sold} ausverkauft</span></div><div class="list">` +
          arr.map((x) => {
            const d = dt(x.d), on = x.s === 'ausverkauft';
            return `<div class="row${on ? ' is-sold' : ''}${pending.has(x.idx) ? ' is-busy' : ''}">
              <div class="date"><div class="wd">${WD[d.getDay()]}</div><div class="d">${d.getDate()}.</div><div class="t">${x.u}</div></div>
              <div class="info"><b>${esc(x.t)}</b><div class="o"><span class="tag">${x.a === 'dinner' ? 'Dinner' : 'Theater'}</span>${esc(x.o)}</div>
                <div class="cnt${x.p === 0 ? ' is-null' : ''}" data-idx="${x.idx}">
                  <button type="button" class="cm" data-idx="${x.idx}" aria-label="Ein Platz weniger" ${x.p === null || x.p === 0 ? 'disabled' : ''}>−</button>
                  <input class="cv" type="number" inputmode="numeric" min="0" max="9999" placeholder="–" value="${x.p ?? ''}" data-idx="${x.idx}" aria-label="Freie Plätze ${esc(x.t)} am ${kurz(x)}" />
                  <button type="button" class="cp" data-idx="${x.idx}" aria-label="Ein Platz mehr">+</button>
                  <span class="cl">freie Plätze</span><span class="cs" data-idx="${x.idx}"></span>
                </div></div>
              <button class="sw" role="switch" aria-checked="${on}" data-idx="${x.idx}" ${pending.has(x.idx) ? 'disabled' : ''} aria-label="${esc(x.t)} am ${kurz(x)} ausverkauft">
                <span class="track"></span><span class="label">${on ? 'Ausverkauft' : 'Karten frei'}</span>
              </button></div>`;
          }).join('') + '</div>';
      }).join('');
    }

    function zeige(html: string, mitUndo: boolean, fehler = false) {
      tmsg.innerHTML = html;
      undoBtn.hidden = !mitUndo;
      toast.classList.toggle('is-err', fehler);
      toast.classList.add('show');
      clearTimeout(timer);
      timer = window.setTimeout(() => toast.classList.remove('show'), fehler ? 9000 : 6000);
    }

    async function setze(x: Item, status: string, prev: string, undo: boolean) {
      x.s = status; pending.add(x.idx); render();
      try {
        const res = await fetch('/sinahamala/api', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ key: x.key, idx: x.idx, status }),
        });
        const j = await res.json().catch(() => ({}));
        if (res.status === 401) { location.reload(); return; }
        if (!res.ok) throw new Error(j.fehler || 'Speichern fehlgeschlagen.');
        last = undo ? null : { item: x, prev };
        zeige(`<b>${esc(x.t)}, ${kurz(x)}</b> ist jetzt ${status === 'ausverkauft' ? '<b>ausverkauft</b>' : '<b>wieder buchbar</b>'}.<small>Gespeichert · auf der Website in ca. 2 Minuten sichtbar</small>`, !undo);
      } catch (e) {
        x.s = prev;
        zeige(`<b>Nicht gespeichert.</b><small>${esc((e as Error).message)}</small>`, false, true);
      } finally {
        pending.delete(x.idx); render();
      }
    }

    // ---- Ticket-Zähler: Klicks sammeln, 2 s nach dem letzten Klick einmal speichern ----
    const zTimer = new Map<number, number>();
    const gespeichert = new Map<number, number | null>(items.map((x) => [x.idx, x.p]));
    const zeile = (idx: number) => out.querySelector<HTMLElement>(`.cnt[data-idx="${idx}"]`);
    function zAnzeigen(x: Item, hinweis = '') {
      const c = zeile(x.idx);
      if (!c) return;
      const inp = c.querySelector<HTMLInputElement>('.cv')!;
      if (document.activeElement !== inp) inp.value = x.p === null ? '' : String(x.p);
      c.querySelector<HTMLButtonElement>('.cm')!.disabled = x.p === null || x.p === 0;
      c.classList.toggle('is-null', x.p === 0);
      c.querySelector<HTMLElement>('.cs')!.textContent = hinweis;
    }
    function zPlanen(x: Item) {
      clearTimeout(zTimer.get(x.idx));
      zAnzeigen(x, x.p === gespeichert.get(x.idx) ? '' : '…');
      zTimer.set(x.idx, window.setTimeout(() => zSpeichern(x), 2000));
    }
    async function zSpeichern(x: Item) {
      zTimer.delete(x.idx);
      const wert = x.p;
      if (wert === gespeichert.get(x.idx)) { zAnzeigen(x); return; }
      zAnzeigen(x, 'speichert …');
      try {
        const res = await fetch('/sinahamala/plaetze', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ key: x.key, idx: x.idx, plaetze: wert }),
        });
        const j = await res.json().catch(() => ({}));
        if (res.status === 401) { location.reload(); return; }
        if (!res.ok) throw new Error(j.fehler || 'Speichern fehlgeschlagen.');
        gespeichert.set(x.idx, wert);
        const statusAlt = x.s;
        x.s = j.status || x.s;
        if (x.s !== statusAlt) {
          render();
          zeige(`<b>${esc(x.t)}, ${kurz(x)}</b> ist jetzt ${x.s === 'ausverkauft' ? '<b>ausverkauft</b> (0 Plätze)' : '<b>wieder buchbar</b>'}.<small>Gespeichert · auf der Website in ca. 2 Minuten sichtbar</small>`, false);
        } else if (x.p === wert) {
          zAnzeigen(x, '✓');
          window.setTimeout(() => { if (x.p === wert) zAnzeigen(x); }, 2500);
        }
      } catch (e) {
        zAnzeigen(x, '');
        zeige(`<b>Plätze nicht gespeichert.</b><small>${esc((e as Error).message)}</small>`, false, true);
      }
    }
    out.addEventListener('click', (e) => {
      const btn = (e.target as HTMLElement).closest<HTMLButtonElement>('.cm, .cp');
      if (!btn) return;
      const x = items.find((i) => i.idx === Number(btn.dataset.idx));
      if (!x) return;
      const plus = btn.classList.contains('cp');
      x.p = plus ? (x.p ?? 0) + 1 : Math.max(0, (x.p ?? 0) - 1);
      zPlanen(x);
    });
    out.addEventListener('input', (e) => {
      const inp = e.target as HTMLInputElement;
      if (!inp.classList.contains('cv')) return;
      const x = items.find((i) => i.idx === Number(inp.dataset.idx));
      if (!x) return;
      const v = inp.value.trim();
      const n = Math.round(Number(v));
      x.p = v === '' ? null : Number.isFinite(n) ? Math.min(9999, Math.max(0, n)) : x.p;
      zPlanen(x);
    });
    out.addEventListener('focusout', (e) => {
      const inp = e.target as HTMLInputElement;
      if (!inp.classList?.contains('cv')) return;
      const x = items.find((i) => i.idx === Number(inp.dataset.idx));
      if (x) zAnzeigen(x, zTimer.has(x.idx) ? '…' : '');
    });

    out.addEventListener('click', (e) => {
      const b = (e.target as HTMLElement).closest<HTMLButtonElement>('.sw');
      if (!b || b.disabled) return;
      const x = items.find((i) => i.idx === Number(b.dataset.idx));
      if (!x) return;
      setze(x, x.s === 'ausverkauft' ? 'verfuegbar' : 'ausverkauft', x.s, false);
    });
    undoBtn.addEventListener('click', () => {
      if (!last) return;
      const { item, prev } = last; last = null;
      toast.classList.remove('show');
      setze(item, prev, item.s, true);
    });
    document.querySelectorAll<HTMLButtonElement>('.chip').forEach((c) => c.addEventListener('click', () => {
      filter = c.dataset.f!;
      document.querySelectorAll('.chip').forEach((o) => o.setAttribute('aria-pressed', String(o === c)));
      render();
    }));
    document.getElementById('q')!.addEventListener('input', (e) => { query = (e.target as HTMLInputElement).value.trim().toLowerCase(); render(); });
    render();
  }
</script>

<script>
  // Tabs + Formulare „Termine eintragen“ und „Neues Stück“
  const dataEl = document.getElementById('sh-data');
  if (dataEl) {
    type Stueck = { id: string; t: string; typ: string; p: number };
    const D = JSON.parse(dataEl.textContent || '{}') as { heute: string; bis: string; warnJahre: number; stuecke: any[]; orte: string[] };
    const $ = <T extends HTMLElement = HTMLElement>(id: string) => document.getElementById(id) as T;
    const esc = (s: string) => s.replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]!));
    const de = (iso: string) => { const [y, m, d] = iso.split('-'); return `${d}.${m}.${y}`; };
    const toast = (html: string, fehler = false) => (window as any).__zeige?.(html, fehler);

    // ---- Tabs ----
    const tabs = document.querySelectorAll<HTMLButtonElement>('.tab');
    function zeigeTab(name: string) {
      tabs.forEach((t) => t.setAttribute('aria-selected', String(t.dataset.tab === name)));
      document.querySelectorAll<HTMLElement>('[data-panel]').forEach((p) => (p.hidden = p.dataset.panel !== name));
      try { sessionStorage.setItem('sh-tab', name); } catch {}
      window.scrollTo({ top: 0 });
    }
    tabs.forEach((t) => t.addEventListener('click', () => zeigeTab(t.dataset.tab!)));
    try { const s = sessionStorage.getItem('sh-tab'); if (s) zeigeTab(s); } catch {}

    // ---- Termine eintragen ----
    const sel = $<HTMLSelectElement>('t-stueck');
    function stueckOptionen(waehle?: string) {
      sel.innerHTML = '<option value="">Bitte wählen …</option>' +
        D.stuecke.map((s) => `<option value="${esc(s.id)}">${esc(s.t)}</option>`).join('');
      if (waehle) sel.value = waehle;
    }
    stueckOptionen();
    $('orte').innerHTML = D.orte.map((o) => `<option value="${esc(o)}"></option>`).join('');
    // Ab hier nachfragen (Tippfehler beim Jahr abfangen), aber nicht blockieren
    const warnAb = (() => { const [y, m, d] = D.heute.split('-'); return `${Number(y) + D.warnJahre}-${m}-${d}`; })();
    sel.addEventListener('change', () => {
      const s = D.stuecke.find((x) => x.id === sel.value);
      if (s) $<HTMLSelectElement>('t-art').value = s.typ === 'dinner' ? 'dinner' : 'theater';
    });

    const rows = $('t-rows');
    function neueZeile(datum = '', uhrzeit = '') {
      const letzte = rows.querySelector<HTMLInputElement>('.row-d:last-child .u');
      const div = document.createElement('div');
      div.className = 'row-d';
      div.innerHTML = `<input type="date" class="d" min="${D.heute}" max="${D.bis}" required aria-label="Datum" />
        <input type="time" class="u" required aria-label="Uhrzeit" step="300" />
        <button type="button" class="x" aria-label="Datum entfernen">×</button>`;
      (div.querySelector('.d') as HTMLInputElement).value = datum;
      (div.querySelector('.u') as HTMLInputElement).value = uhrzeit || letzte?.value || '20:00';
      rows.appendChild(div);
      return div;
    }
    rows.addEventListener('click', (e) => {
      const b = (e.target as HTMLElement).closest('.x');
      if (!b) return;
      b.parentElement!.remove();
      if (!rows.children.length) neueZeile();
    });
    $('t-add').addEventListener('click', () => (neueZeile().querySelector('.d') as HTMLInputElement).focus());
    neueZeile();

    const tErr = $('t-err');
    const fehlerT = (msg: string) => { tErr.textContent = msg; tErr.hidden = !msg; if (msg) tErr.scrollIntoView({ block: 'center', behavior: 'smooth' }); };
    $<HTMLFormElement>('f-termine').addEventListener('submit', async (e) => {
      e.preventDefault();
      fehlerT('');
      const produktion = sel.value;
      const ort = $<HTMLInputElement>('t-ort').value.trim();
      if (!produktion) return fehlerT('Bitte ein Stück wählen.');
      if (!ort) return fehlerT('Bitte einen Spielort eingeben.');
      const termine: { datum: string; uhrzeit: string }[] = [];
      for (const r of rows.querySelectorAll('.row-d')) {
        const d = (r.querySelector('.d') as HTMLInputElement).value;
        const u = (r.querySelector('.u') as HTMLInputElement).value;
        if (!d && rows.children.length > 1) continue; // leere Zusatzzeilen ignorieren
        if (!d) return fehlerT('Bitte ein Datum eintragen.');
        if (d < D.heute) return fehlerT(`Der ${de(d)} liegt in der Vergangenheit.`);
        if (d > D.bis) return fehlerT(`Der ${de(d)} kann nicht stimmen – bitte das Jahr prüfen.`);
        if (!u) return fehlerT(`Bitte eine Uhrzeit für den ${de(d)} eintragen.`);
        termine.push({ datum: d, uhrzeit: u });
      }
      const weit = termine.filter((t) => t.datum > warnAb);
      if (weit.length && !confirm(`${weit.map((t) => de(t.datum)).join(', ')} – mehr als ${D.warnJahre} Jahre im Voraus. Ist das Jahr richtig?`)) return;
      const btn = $<HTMLButtonElement>('t-save');
      btn.disabled = true; btn.textContent = 'Wird gespeichert …';
      try {
        const res = await fetch('/sinahamala/termine', {
          method: 'POST', headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            produktion, ort, termine,
            art: $<HTMLSelectElement>('t-art').value,
            preis: $<HTMLInputElement>('t-preis').value,
            titel: sel.selectedOptions[0]?.textContent ?? '',
          }),
        });
        const j = await res.json().catch(() => ({}));
        if (res.status === 401) { location.reload(); return; }
        if (!res.ok) throw new Error(j.fehler || 'Speichern fehlgeschlagen.');
        const titel = esc(sel.selectedOptions[0]?.textContent ?? '');
        toast(j.neu
          ? `<b>${j.neu} ${j.neu === 1 ? 'Termin' : 'Termine'}</b> für <b>${titel}</b> gespeichert.${j.doppelt ? ` (${j.doppelt} gab es schon)` : ''}<small>Auf der Website in ca. 2 Minuten sichtbar</small>`
          : `Diese Termine für <b>${titel}</b> gab es schon – nichts geändert.`);
        rows.innerHTML = ''; neueZeile();
      } catch (err) {
        fehlerT((err as Error).message);
      } finally {
        btn.disabled = false; btn.textContent = 'Termine speichern';
      }
    });

    // ---- Stücke: Liste, Neu, Bearbeiten, Löschen ----
    type S = Stueck & { u: string; r: number; img: string | null; text: string; k: number };
    const liste = $('s-liste');
    const form = $<HTMLFormElement>('f-stueck');
    const uebersicht = $('s-uebersicht');
    const bildInput = $<HTMLInputElement>('s-bild');
    const vorschau = $<HTMLImageElement>('s-vorschau');
    const drop = $('s-drop');
    const ART: Record<string, string> = { theater: 'Theater', dinner: 'Dinner', familie: 'Familie' };
    let bildB64: string | null = null;
    let bearbeite: S | null = null;     // null = neues Stück
    let loeschFrage: string | null = null; // id mit offener Rückfrage
    const busy = new Set<string>();

    function renderListe() {
      const alle = D.stuecke as S[];
      if (!alle.length) { liste.innerHTML = '<p class="empty">Noch keine Stücke.</p>'; return; }
      liste.innerHTML = alle.map((s) => {
        const frage = loeschFrage === s.id;
        const bild = s.img ? `<img src="${esc(s.img)}" alt="" loading="lazy" />` : '<span class="ph">Plakat folgt</span>';
        const info = `${esc(s.u)} · ${ART[s.typ] ?? 'Theater'} · ab ${s.p} €` +
          `<br><span class="${s.k ? 'k' : 'k0'}">${s.k ? `${s.k} kommende Vorstellung${s.k === 1 ? '' : 'en'}` : 'keine kommenden Vorstellungen'}</span>` +
          (s.r < 20 ? ' · <span class="k0">Startseite</span>' : '');
        return `<div class="s-item${frage ? ' is-frage' : ''}${busy.has(s.id) ? ' is-busy' : ''}" data-id="${esc(s.id)}">
          <div class="s-bild">${bild}</div>
          <div class="s-info"><b>${esc(s.t)}</b><small>${info}</small></div>
          ${frage ? `<div class="s-frage">
              <p><b>„${esc(s.t)}“ endgültig löschen?</b>${s.k ? ` Auch <b>${s.k} kommende Vorstellung${s.k === 1 ? '' : 'en'}</b> werden aus dem Spielplan entfernt.` : ''} Das kann hier nicht rückgängig gemacht werden.</p>
              <div class="s-btns"><button type="button" class="ghost" data-a="nein">Abbrechen</button><button type="button" class="danger" data-a="ja" ${busy.has(s.id) ? 'disabled' : ''}>${busy.has(s.id) ? 'Wird gelöscht …' : 'Endgültig löschen'}</button></div>
            </div>`
          : `<div class="s-btns"><button type="button" class="ghost" data-a="edit">Bearbeiten</button><button type="button" class="ghost del" data-a="del">Löschen</button></div>`}
        </div>`;
      }).join('');
    }

    function bildZuruecksetzen(url: string | null = null) {
      bildB64 = null; bildInput.value = '';
      vorschau.hidden = !url; if (url) vorschau.src = url; else vorschau.removeAttribute('src');
      drop.classList.toggle('has-img', !!url);
      $('s-droptext').innerHTML = url
        ? 'Aktuelles Plakat<small>Neues Bild wählen, um es zu ersetzen.</small>'
        : 'Bild auswählen oder hierher ziehen<small>JPG oder PNG, Hochformat (3:4)</small>';
    }

    function oeffneFormular(s: S | null) {
      bearbeite = s; sErr('');
      form.reset();
      $('s-h2').textContent = s ? 'Stück bearbeiten' : 'Neues Stück anlegen';
      $('s-lead').textContent = s ? `Adresse bleibt /programm/${s.id}, auch wenn der Titel geändert wird.` : 'Danach unter „Termine eintragen“ die Vorstellungen hinzufügen.';
      $('s-save').textContent = s ? 'Änderungen speichern' : 'Stück anlegen';
      if (s) {
        $<HTMLInputElement>('s-titel').value = s.t;
        $<HTMLInputElement>('s-unter').value = s.u;
        $<HTMLSelectElement>('s-typ').value = s.typ;
        $<HTMLInputElement>('s-preis').value = String(s.p);
        $<HTMLTextAreaElement>('s-text').value = s.text;
        $<HTMLInputElement>('s-start').checked = s.r < 20;
      }
      bildZuruecksetzen(s?.img ?? null);
      uebersicht.hidden = true; form.hidden = false;
      window.scrollTo({ top: 0 });
    }
    function schliesseFormular() { form.hidden = true; uebersicht.hidden = false; bearbeite = null; renderListe(); }

    $('s-neu').addEventListener('click', () => oeffneFormular(null));
    $('s-abbrechen').addEventListener('click', schliesseFormular);

    liste.addEventListener('click', async (e) => {
      const btn = (e.target as HTMLElement).closest<HTMLButtonElement>('button[data-a]');
      if (!btn) return;
      const id = btn.closest<HTMLElement>('.s-item')!.dataset.id!;
      const s = (D.stuecke as S[]).find((x) => x.id === id);
      if (!s) return;
      const a = btn.dataset.a;
      if (a === 'edit') return oeffneFormular(s);
      if (a === 'del') { loeschFrage = id; return renderListe(); }
      if (a === 'nein') { loeschFrage = null; return renderListe(); }
      if (a === 'ja') {
        busy.add(id); renderListe();
        try {
          const res = await fetch('/sinahamala/loeschen', {
            method: 'POST', headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ produktion: id, titel: s.t }),
          });
          const j = await res.json().catch(() => ({}));
          if (res.status === 401) { location.reload(); return; }
          if (!res.ok) throw new Error(j.fehler || 'Löschen fehlgeschlagen.');
          D.stuecke = D.stuecke.filter((x) => x.id !== id);
          stueckOptionen();
          loeschFrage = null;
          toast(`<b>${esc(s.t)}</b> wurde gelöscht${j.entfernt ? ` – mit ${j.entfernt} Termin${j.entfernt === 1 ? '' : 'en'}` : ''}.<small>Auf der Website in ca. 2 Minuten verschwunden</small>`);
        } catch (err) {
          toast(`<b>Nicht gelöscht.</b><small>${esc((err as Error).message)}</small>`, true);
        } finally {
          busy.delete(id); renderListe();
        }
      }
    });

    /** Bild im Browser auf max. 1000 px Breite verkleinern und als JPEG speichern */
    async function bildVorbereiten(file: File): Promise<string> {
      if (!/^image\/(jpeg|png|webp)$/.test(file.type)) throw new Error('Bitte ein JPG- oder PNG-Bild wählen.');
      if (file.size > 30 * 1024 * 1024) throw new Error('Das Bild ist zu groß (max. 30 MB).');
      const url = URL.createObjectURL(file);
      try {
        const img = new Image();
        img.src = url;
        await img.decode();
        if (img.naturalWidth < 400) throw new Error('Das Bild ist zu klein – bitte mindestens 750 px breit.');
        const w = Math.min(1000, img.naturalWidth);
        const h = Math.round(img.naturalHeight * (w / img.naturalWidth));
        const c = document.createElement('canvas');
        c.width = w; c.height = h;
        const ctx = c.getContext('2d')!;
        ctx.fillStyle = '#fff'; ctx.fillRect(0, 0, w, h); // transparente PNGs
        ctx.drawImage(img, 0, 0, w, h);
        return c.toDataURL('image/jpeg', 0.86);
      } finally {
        URL.revokeObjectURL(url);
      }
    }
    async function bildGewaehlt(file?: File) {
      sErr('');
      if (!file) return;
      try {
        bildB64 = await bildVorbereiten(file);
        vorschau.src = bildB64; vorschau.hidden = false;
        drop.classList.add('has-img');
        $('s-droptext').innerHTML = `${esc(file.name)}<small>${bearbeite ? 'Ersetzt das bisherige Plakat beim Speichern.' : 'Anderes Bild? Einfach erneut auswählen.'}</small>`;
      } catch (err) {
        bildZuruecksetzen(bearbeite?.img ?? null);
        sErr((err as Error).message);
      }
    }
    bildInput.addEventListener('change', () => bildGewaehlt(bildInput.files?.[0]));
    drop.addEventListener('dragover', (e) => { e.preventDefault(); drop.classList.add('over'); });
    drop.addEventListener('dragleave', () => drop.classList.remove('over'));
    drop.addEventListener('drop', (e) => { e.preventDefault(); drop.classList.remove('over'); bildGewaehlt(e.dataTransfer?.files?.[0]); });

    const sErrEl = $('s-err');
    function sErr(msg: string) { sErrEl.textContent = msg; sErrEl.hidden = !msg; if (msg) sErrEl.scrollIntoView({ block: 'center', behavior: 'smooth' }); }

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      sErr('');
      const titel = $<HTMLInputElement>('s-titel').value.trim();
      const untertitel = $<HTMLInputElement>('s-unter').value.trim();
      const preisAb = $<HTMLInputElement>('s-preis').value;
      if (!titel) return sErr('Bitte einen Titel eingeben.');
      if (!untertitel) return sErr('Bitte eine Genre-Zeile eingeben (z. B. „Gauner-Komödie“).');
      if (preisAb === '') return sErr('Bitte einen Preis eingeben.');
      if (D.stuecke.some((s) => s.id !== bearbeite?.id && s.t.toLowerCase() === titel.toLowerCase())) return sErr(`„${titel}“ gibt es schon.`);
      if (!bearbeite && !bildB64 && !confirm('Ohne Plakat speichern? Auf der Website steht dann „Plakat folgt“.')) return;
      const btn = $<HTMLButtonElement>('s-save');
      const btnText = btn.textContent;
      btn.disabled = true; btn.textContent = 'Wird gespeichert …';
      const daten = {
        titel, untertitel, preisAb,
        typ: $<HTMLSelectElement>('s-typ').value,
        beschreibung: $<HTMLTextAreaElement>('s-text').value,
        startseite: $<HTMLInputElement>('s-start').checked,
        plakat: bildB64 ? { base64: bildB64 } : null,
      };
      try {
        const res = await fetch(bearbeite ? '/sinahamala/bearbeiten' : '/sinahamala/stueck', {
          method: 'POST', headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(bearbeite ? { ...daten, produktion: bearbeite.id } : daten),
        });
        const j = await res.json().catch(() => ({}));
        if (res.status === 401) { location.reload(); return; }
        if (!res.ok) throw new Error(j.fehler || 'Speichern fehlgeschlagen.');
        const eintrag = {
          id: j.id, t: j.titel, typ: daten.typ, p: Number(preisAb), u: untertitel, text: daten.beschreibung,
          r: daten.startseite ? (bearbeite && bearbeite.r < 20 ? bearbeite.r : 19) : (bearbeite && bearbeite.r >= 20 ? bearbeite.r : 30),
          img: bildB64 ?? bearbeite?.img ?? null, k: bearbeite?.k ?? 0,
        };
        if (bearbeite) {
          const i = D.stuecke.findIndex((x) => x.id === bearbeite!.id);
          D.stuecke[i] = eintrag;
          stueckOptionen(sel.value);
          schliesseFormular();
          toast(j.unveraendert ? `Keine Änderungen an <b>${esc(j.titel)}</b>.` : `<b>${esc(j.titel)}</b> gespeichert.<small>Auf der Website in ca. 2 Minuten sichtbar</small>`);
        } else {
          D.stuecke.push(eintrag);
          stueckOptionen(j.id);
          schliesseFormular();
          zeigeTab('termine');
          toast(`<b>${esc(j.titel)}</b> ist angelegt. Jetzt die Termine eintragen.<small>Auf der Website in ca. 2 Minuten sichtbar</small>`);
        }
      } catch (err) {
        sErr((err as Error).message);
      } finally {
        btn.disabled = false; btn.textContent = btnText;
      }
    });
    renderListe();
  }
</script>

<style is:global>
  :root {
    --wine: #421531; --wine-deep: #2c0d20; --wine-soft: #54203f; --row: #3a1229;
    --amber: #f4a14d; --amber-bright: #ffbd73;
    --cream: #f7ece0; --cream-dim: #d8c4b8; --line: rgba(247, 236, 224, .14);
    --sold: #e0525f; --sold-bg: rgba(224, 82, 95, .16); --ok: #6fcf97; --ok-bg: rgba(111, 207, 151, .13);
    --display: "Fraunces Variable", "Fraunces", Georgia, serif;
    --body: "Libre Franklin Variable", "Libre Franklin", system-ui, sans-serif;
    color-scheme: dark;
  }
  * { box-sizing: border-box; }
  html, body { margin: 0; }
  body { background: var(--wine-deep); color: var(--cream); font-family: var(--body); font-size: 15px; -webkit-font-smoothing: antialiased; }
  [hidden] { display: none !important; }
  .kick { display: block; font-size: 11px; letter-spacing: .16em; text-transform: uppercase; color: var(--amber); font-weight: 700; }
  h1 { font-family: var(--display); font-weight: 800; font-size: 26px; margin: 2px 0 0; line-height: 1.1; }
  button:focus-visible, input:focus-visible { outline: 2px solid var(--amber); outline-offset: 2px; }
  .err { color: #ffb3ba; background: var(--sold-bg); border: 1px solid rgba(224, 82, 95, .45); border-radius: 10px; padding: 10px 12px; font-size: 14px; margin: 0; }
  .err.big { margin-top: 16px; }

  /* Login */
  .login { min-height: 100vh; min-height: 100dvh; display: grid; place-items: center; padding: 24px max(16px, env(safe-area-inset-left)); }
  .login-box { width: min(380px, 100%); display: grid; gap: 12px; background: var(--wine); border: 1px solid var(--line); border-radius: 18px; padding: 28px 22px; }
  .login-box h1 { margin-bottom: 10px; }
  .login-box label { font-size: 13px; font-weight: 600; color: var(--cream-dim); }
  .login-box input { font: inherit; font-size: 17px; color: var(--cream); background: var(--wine-deep); border: 1px solid var(--line); border-radius: 12px; padding: 13px 14px; }
  .login-box button { font: inherit; font-weight: 700; font-size: 16px; color: var(--wine-deep); background: var(--amber); border: 0; border-radius: 12px; padding: 13px; cursor: pointer; margin-top: 4px; }

  /* Liste */
  .wrap { max-width: 640px; margin: 0 auto; padding: 0 max(16px, env(safe-area-inset-right)) 120px max(16px, env(safe-area-inset-left)); }
  header { position: sticky; top: 0; z-index: 5; background: var(--wine-deep); padding: calc(16px + env(safe-area-inset-top)) 0 12px; border-bottom: 1px solid var(--line); display: grid; gap: 12px; }
  .top { display: flex; align-items: center; justify-content: space-between; gap: 12px; }
  .logout { font: inherit; font-size: 13px; font-weight: 600; color: var(--cream-dim); background: transparent; border: 1px solid var(--line); border-radius: 10px; padding: 8px 12px; cursor: pointer; }
  .search { width: 100%; font: inherit; font-size: 16px; color: var(--cream); background: var(--wine); border: 1px solid var(--line); border-radius: 12px; padding: 12px 14px; }
  .search::placeholder { color: var(--cream-dim); opacity: .7; }
  .chips { display: flex; gap: 8px; overflow-x: auto; scrollbar-width: none; padding-bottom: 2px; }
  .chip { flex: none; font: inherit; font-size: 13px; font-weight: 600; color: var(--cream-dim); background: transparent; border: 1px solid var(--line); border-radius: 999px; padding: 7px 13px; cursor: pointer; }
  .chip[aria-pressed="true"] { color: var(--wine-deep); background: var(--amber); border-color: var(--amber); }
  .month { font-family: var(--display); font-weight: 600; font-size: 15px; color: var(--amber-bright); margin: 26px 0 10px; display: flex; justify-content: space-between; align-items: baseline; gap: 8px; }
  .month span { font-family: var(--body); font-size: 12px; color: var(--cream-dim); font-weight: 500; }
  .list { display: grid; gap: 8px; }
  .row { display: grid; grid-template-columns: 54px 1fr auto; gap: 12px; align-items: center; background: var(--row); border: 1px solid var(--line); border-radius: 14px; padding: 12px; transition: background .2s, border-color .2s, opacity .2s; }
  .row.is-sold { background: var(--sold-bg); border-color: rgba(224, 82, 95, .45); }
  .row.is-busy { opacity: .6; }
  .date { text-align: center; line-height: 1.05; font-variant-numeric: tabular-nums; }
  .date .wd { font-size: 11px; text-transform: uppercase; letter-spacing: .1em; color: var(--cream-dim); }
  .date .d { font-family: var(--display); font-weight: 800; font-size: 24px; }
  .date .t { font-size: 12px; color: var(--amber); font-weight: 600; margin-top: 2px; }
  .info { min-width: 0; }
  .info b { display: block; font-weight: 600; font-size: 15px; line-height: 1.3; }
  .info .o { font-size: 13px; color: var(--cream-dim); margin-top: 3px; line-height: 1.35; }
  .tag { display: inline-block; font-size: 10.5px; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; border-radius: 6px; padding: 2px 6px; margin-right: 6px; background: var(--wine-soft); color: var(--amber-bright); vertical-align: 1px; }
  /* Ticket-Zähler */
  .cnt { display: flex; align-items: center; gap: 6px; margin-top: 8px; flex-wrap: wrap; }
  .cnt button { font: inherit; font-size: 18px; font-weight: 700; line-height: 1; width: 34px; height: 34px; border-radius: 10px; border: 1px solid var(--line); background: var(--wine-soft); color: var(--cream); cursor: pointer; display: grid; place-items: center; padding: 0; }
  .cnt button:disabled { opacity: .35; cursor: default; }
  .cnt .cv { width: 62px; height: 34px; font: inherit; font-size: 16px; font-weight: 700; text-align: center; color: var(--cream); background: var(--wine-deep); border: 1px solid var(--line); border-radius: 10px; padding: 0 4px; -moz-appearance: textfield; }
  .cnt .cv::-webkit-outer-spin-button, .cnt .cv::-webkit-inner-spin-button { -webkit-appearance: none; margin: 0; }
  .cnt .cv::placeholder { color: var(--cream-dim); opacity: .6; }
  .cnt.is-null .cv { color: #ffb3ba; border-color: rgba(224, 82, 95, .55); }
  .cnt .cl { font-size: 12px; color: var(--cream-dim); }
  .cnt .cs { font-size: 12px; color: var(--amber); min-width: 1em; }
  .sw { font: inherit; cursor: pointer; border: 0; border-radius: 12px; min-width: 104px; padding: 10px; font-size: 13px; font-weight: 700; display: grid; justify-items: center; gap: 6px; background: var(--ok-bg); color: var(--ok); }
  .sw:disabled { cursor: progress; }
  .sw .track { width: 46px; height: 26px; border-radius: 999px; background: rgba(111, 207, 151, .35); position: relative; transition: background .2s; }
  .sw .track::after { content: ""; position: absolute; top: 3px; left: 3px; width: 20px; height: 20px; border-radius: 50%; background: var(--cream); transition: transform .2s; }
  .sw[aria-checked="true"] { background: var(--sold); color: #fff; }
  .sw[aria-checked="true"] .track { background: rgba(0, 0, 0, .25); }
  .sw[aria-checked="true"] .track::after { transform: translateX(20px); }
  .empty, .hint { color: var(--cream-dim); text-align: center; }
