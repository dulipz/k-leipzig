---
// Moderne Diashow der Spielstätte (Saal, Theater-Bar, Sommertheater).
// Bilder liegen unter /public/images/spielstaette (+ /thumb für die Vorschauleiste).
const bilder = [
  { n: 'sommertheater', titel: 'Sommertheater im Innenhof', text: 'Theater unter freiem Himmel — an lauen Sommerabenden.' },
  { n: 'saal-1', titel: 'Unser Theatersaal', text: '80 Plätze, ganz nah dran am Geschehen.' },
  { n: 'saal-2', titel: 'Bühne frei', text: 'Licht an, Vorhang auf — hier wird gelacht.' },
  { n: 'saal-3', titel: 'Rote Sessel, roter Vorhang', text: 'Klassisches Theatergefühl in der alten Scheune.' },
  { n: 'bar-1', titel: 'Die Theater-Bar', text: 'Vor der Vorstellung und in der Pause für Sie da.' },
  { n: 'bar-3', titel: 'Auf einen guten Abend', text: 'Ein Glas Sekt gehört einfach dazu.' },
  { n: 'bar-4', titel: 'Treffpunkt in der Pause', text: 'Gute Gespräche, gute Laune, gute Getränke.' },
  { n: 'bar-2', titel: 'Zum Wohl!', text: 'Unser Barteam freut sich auf Sie.' },
  { n: 'saal-4', titel: 'Liebe zum Detail', text: 'Goldene Tapeten, Kerzenleuchter, ein Hauch Nostalgie.' },
  { n: 'saal-5', titel: 'Theaterzauber', text: 'Jede Ecke erzählt ein bisschen Bühnengeschichte.' },
  { n: 'bar-5', titel: 'Es leuchtet an der Bar', text: 'Bunt, fröhlich — wie unsere Komödien.' },
];
const pad = (i: number) => String(i).padStart(2, '0');
---

<div class="ss" data-ss aria-roledescription="Diashow" aria-label="Bilder der Kleinen Komödie Reuden">
  <div class="ss-stage" tabindex="0">
    {bilder.map((b, i) => (
      <figure
        class:list={['ss-slide', { 'is-active': i === 0 }]}
        aria-roledescription="Folie"
        aria-label={`${i + 1} von ${bilder.length}: ${b.titel}`}
        aria-hidden={i === 0 ? 'false' : 'true'}
      >
        <img
          src={`/images/spielstaette/${b.n}.jpg`}
          alt={`${b.titel} – ${b.text}`}
          loading={i < 2 ? 'eager' : 'lazy'}
          decoding="async"
        />
        <figcaption>
          <span class="ss-num">{pad(i + 1)} <i>/ {pad(bilder.length)}</i></span>
          <b>{b.titel}</b>
          <span class="ss-txt">{b.text}</span>
        </figcaption>
      </figure>
    ))}
    <button class="ss-nav ss-prev" type="button" aria-label="Vorheriges Bild">‹</button>
    <button class="ss-nav ss-next" type="button" aria-label="Nächstes Bild">›</button>
    <button class="ss-play" type="button" aria-label="Diashow pausieren" data-playing="true">
      <span class="i-pause">❚❚</span><span class="i-play">▶</span>
    </button>
    <div class="ss-progress"><span></span></div>
  </div>

  <div class="ss-thumbs" role="tablist" aria-label="Bild auswählen">
    {bilder.map((b, i) => (
      <button
        class:list={['ss-thumb', { 'is-active': i === 0 }]}
        type="button"
        role="tab"
        aria-selected={i === 0 ? 'true' : 'false'}
        aria-label={`Bild ${i + 1}: ${b.titel}`}
      >
        <img src={`/images/spielstaette/thumb/${b.n}.jpg`} alt="" loading="lazy" decoding="async" />
      </button>
    ))}
  </div>
</div>

<style>
  .ss { --dauer: 6000ms; margin-top: 46px; }
  .ss-stage {
    position: relative; overflow: hidden; border-radius: 22px;
    aspect-ratio: 16 / 8; background: var(--wine-deep);
    box-shadow: var(--shadow); border: 1px solid var(--line); outline: none;
  }
  .ss-stage:focus-visible { outline: 3px solid var(--amber); outline-offset: 3px; }
  .ss-slide { position: absolute; inset: 0; margin: 0; opacity: 0; transition: opacity 1.1s ease; }
  .ss-slide.is-active { opacity: 1; z-index: 1; }
  .ss-slide img {
    width: 100%; height: 100%; object-fit: cover; display: block;
    transform: scale(1.08); transition: transform 7s ease-out;
  }
  .ss-slide.is-active img { transform: scale(1); }
  .ss-slide::after {
    content: ""; position: absolute; inset: 0; pointer-events: none;
    background: linear-gradient(to top, rgba(28, 8, 20, .88) 0%, rgba(28, 8, 20, .25) 34%, transparent 58%);
  }
  .ss-slide figcaption {
    position: absolute; left: 34px; bottom: 34px; right: 120px; z-index: 2;
    display: flex; flex-direction: column; gap: 4px;
    opacity: 0; transform: translateY(14px); transition: opacity .7s ease .35s, transform .7s ease .35s;
  }
  .ss-slide.is-active figcaption { opacity: 1; transform: none; }
  .ss-num { font-size: 13px; font-weight: 800; letter-spacing: .14em; color: var(--amber); }
  .ss-num i { font-style: normal; color: var(--cream-dim); font-weight: 600; }
  .ss-slide b { font-family: var(--display); font-weight: 900; font-size: clamp(24px, 3.2vw, 40px); line-height: 1.05; color: var(--cream); }
  .ss-txt { color: var(--cream-dim); font-size: 16px; }

  .ss-nav, .ss-play {
    position: absolute; z-index: 3; display: flex; align-items: center; justify-content: center;
    color: var(--cream); background: rgba(0, 0, 0, .35); border: 1px solid var(--line);
    backdrop-filter: blur(6px); border-radius: 999px; cursor: pointer; line-height: 1;
    transition: background .2s, color .2s, opacity .3s;
  }
  .ss-nav { top: 50%; transform: translateY(-50%); width: 52px; height: 52px; font-size: 32px; padding-bottom: 4px; opacity: 0; }
  .ss-prev { left: 18px; }
  .ss-next { right: 18px; }
  .ss-stage:hover .ss-nav, .ss-stage:focus-within .ss-nav { opacity: 1; }
  .ss-play { right: 22px; bottom: 30px; width: 42px; height: 42px; font-size: 13px; }
  .ss-play .i-play, .ss-play[data-playing="false"] .i-pause { display: none; }
  .ss-play[data-playing="false"] .i-play { display: inline; }
  .ss-nav:hover, .ss-play:hover { background: var(--amber); color: var(--ink); }

  .ss-progress { position: absolute; left: 0; right: 0; bottom: 0; height: 4px; z-index: 3; background: rgba(247, 236, 224, .12); }
  .ss-progress span { display: block; height: 100%; width: 0; background: var(--amber); }
  .ss-progress span.run { width: 100%; transition: width var(--dauer) linear; }

  .ss-thumbs {
    display: flex; gap: 10px; margin-top: 14px; overflow-x: auto; padding: 4px 2px 6px;
    scrollbar-width: none; scroll-snap-type: x proximity;
  }
  .ss-thumbs::-webkit-scrollbar { display: none; }
  .ss-thumb {
    flex: 0 0 auto; width: 118px; aspect-ratio: 3 / 2; padding: 0; border: 2px solid transparent;
    border-radius: 10px; overflow: hidden; cursor: pointer; background: var(--wine-deep);
    opacity: .5; transition: opacity .25s, border-color .25s, transform .25s; scroll-snap-align: start;
  }
  .ss-thumb img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .ss-thumb:hover { opacity: .85; transform: translateY(-2px); }
  .ss-thumb.is-active { opacity: 1; border-color: var(--amber); }
  .ss-thumb:focus-visible { outline: 2px solid var(--amber); outline-offset: 2px; }

  @media (max-width: 900px) { .ss-stage { aspect-ratio: 3 / 2; } }
  @media (max-width: 680px) {
    .ss { margin-top: 30px; }
    .ss-stage { aspect-ratio: 4 / 5; border-radius: 16px; }
    .ss-slide figcaption { left: 18px; right: 18px; bottom: 26px; text-align: left; }
    .ss-txt { font-size: 14.5px; }
    .ss-nav { display: none; }
    .ss-play { top: 14px; right: 14px; bottom: auto; width: 38px; height: 38px; }
    .ss-thumb { width: 84px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .ss-slide, .ss-slide img, .ss-slide figcaption { transition: none; transform: none; }
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-ss]').forEach((root) => {
    const stage = root.querySelector<HTMLElement>('.ss-stage')!;
    const slides = Array.from(root.querySelectorAll<HTMLElement>('.ss-slide'));
    const thumbs = Array.from(root.querySelectorAll<HTMLButtonElement>('.ss-thumb'));
    const bar = root.querySelector<HTMLElement>('.ss-progress span')!;
    const playBtn = root.querySelector<HTMLButtonElement>('.ss-play')!;
    const dauer = 6000;
    const reduziert = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    let cur = 0;
    let timer: number | undefined;
    let playing = !reduziert;
    let hover = false;
    let sichtbar = !('IntersectionObserver' in window);

    const go = (n: number) => {
      const next = (n + slides.length) % slides.length;
      if (next === cur) return;
      slides[cur].classList.remove('is-active');
      slides[cur].setAttribute('aria-hidden', 'true');
      thumbs[cur].classList.remove('is-active');
      thumbs[cur].setAttribute('aria-selected', 'false');
      cur = next;
      slides[cur].classList.add('is-active');
      slides[cur].setAttribute('aria-hidden', 'false');
      thumbs[cur].classList.add('is-active');
      thumbs[cur].setAttribute('aria-selected', 'true');
      // Vorschaubild sichtbar halten (nur horizontal scrollen)
      const strip = thumbs[cur].parentElement!;
      const t = thumbs[cur];
      strip.scrollTo({ left: t.offsetLeft - strip.clientWidth / 2 + t.clientWidth / 2, behavior: 'smooth' });
      // nächstes Bild vorladen
      const img = slides[(cur + 1) % slides.length].querySelector('img');
      if (img) img.loading = 'eager';
      restart();
    };

    const restart = () => {
      window.clearTimeout(timer);
      bar.classList.remove('run');
      void bar.offsetWidth; // Animation neu starten
      if (!playing || hover || !sichtbar || document.hidden) return;
      bar.classList.add('run');
      timer = window.setTimeout(() => go(cur + 1), dauer);
    };

    const setPlaying = (p: boolean) => {
      playing = p;
      playBtn.dataset.playing = String(p);
      playBtn.setAttribute('aria-label', p ? 'Diashow pausieren' : 'Diashow abspielen');
      restart();
    };

    root.querySelector('.ss-prev')!.addEventListener('click', () => go(cur - 1));
    root.querySelector('.ss-next')!.addEventListener('click', () => go(cur + 1));
    thumbs.forEach((t, i) => t.addEventListener('click', () => go(i)));
    playBtn.addEventListener('click', () => setPlaying(!playing));

    stage.addEventListener('mouseenter', () => { hover = true; restart(); });
    stage.addEventListener('mouseleave', () => { hover = false; restart(); });
    stage.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowLeft') go(cur - 1);
      else if (e.key === 'ArrowRight') go(cur + 1);
    });
    document.addEventListener('visibilitychange', restart);

    // Wischen auf dem Handy
    let x0: number | null = null;
    let y0 = 0;
    stage.addEventListener('touchstart', (e) => { x0 = e.touches[0].clientX; y0 = e.touches[0].clientY; }, { passive: true });
    stage.addEventListener('touchend', (e) => {
      if (x0 === null) return;
      const dx = e.changedTouches[0].clientX - x0;
      const dy = e.changedTouches[0].clientY - y0;
      if (Math.abs(dx) > 40 && Math.abs(dx) > Math.abs(dy)) go(dx < 0 ? cur + 1 : cur - 1);
      x0 = null;
    });

    // Erst abspielen, wenn die Diashow ins Bild scrollt
    if ('IntersectionObserver' in window) {
      new IntersectionObserver((entries) => {
        sichtbar = entries[0].isIntersecting;
        restart();
      }, { threshold: 0.35 }).observe(stage);
    }
    restart();
    if (reduziert) setPlaying(false);
  });
</script>
