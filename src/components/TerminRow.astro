---
import { dateParts, typLabel, zusatz, preisText, type Typ } from '../lib/format';

interface Props {
  datum: string;
  uhrzeit: string;
  status: 'verfuegbar' | 'ausverkauft';
  ticketUrl?: string;
  titel: string;
  untertitel: string;
  typ: Typ;
  ort?: string | null;
  preis?: number | null;
  heimSeite?: boolean;
}
const { datum, uhrzeit, status, ticketUrl, titel, untertitel, typ, ort, preis, heimSeite } = Astro.props;
const dp = dateParts(datum);
const badge = typLabel(typ);
const ausverkauft = status === 'ausverkauft';
---

<div class="stub" data-datum={datum} data-heim={heimSeite ? "1" : undefined}>
  <div class="date">
    <div class="wd">{dp.wd}</div>
    <div class="d">{dp.day}</div>
    <div class="m">{dp.month}</div>
  </div>
  <div class="info">
    <div class="t">{titel} — {untertitel}</div>
    <div class="meta">
      <span class={`badge ${ausverkauft ? 'sold' : badge.cls}`}>{ausverkauft ? 'Ausverkauft' : badge.label}</span>
      <span>{uhrzeit} Uhr · {zusatz(typ)}</span>
    </div>
    {ort && <div class="meta ort">📍 {ort} · {preisText(preis)}</div>}
  </div>
  <div class="stub-cta">
    {ausverkauft ? (
      <span class="soldout">Ausverkauft</span>
    ) : (
      <a href={ticketUrl ?? '/spielplan'} class="btn btn-amber">Tickets</a>
    )}
  </div>
</div>

<script>
  // Statisch gebaute Seite: vergangene Termine ausblenden, auf der Startseite max. 6 zeigen
  const d = new Date();
  const heute = `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, '0')}-${String(d.getDate()).padStart(2, '0')}`;
  let n = 0;
  document.querySelectorAll<HTMLElement>('.stub[data-heim]').forEach((el) => {
    if ((el.dataset.datum || '') < heute || n >= 6) el.style.display = 'none';
    else n++;
  });
</script>
