---
import { typBadge, type Typ } from '../lib/format';
import { plakatVon, galerien } from '../lib/produktion-medien';

interface Props {
  id: string;
  titel: string;
  untertitel: string;
  typ: Typ;
  preisAb: number;
  plakat?: string | null;
}
const { id, titel, untertitel, typ, preisAb } = Astro.props;
// „Theater“ steht nicht mehr auf den Plakaten (wir spielen ohnehin nur Theater) –
// nur abweichende Arten wie Familienstück oder Dinner bekommen ein Etikett.
const badge = typ === 'theater' ? null : typBadge(typ);
const plakat = plakatVon(id, { plakat: Astro.props.plakat });
const hatFotos = Boolean(galerien[id]);
const href = `/programm/${id}`;
---

<article class="card">
  <a
    href={href}
    class:list={["poster", { "has-img": plakat }]}
    style={plakat ? `background-image:url('${plakat}')` : undefined}
    aria-label={`${titel.replace(/<[^>]+>/g, '')} – Details${hatFotos ? ' und Szenenfotos' : ''}`}
  >
    {!plakat && <span class="ph-tag">Plakat folgt</span>}
    {badge && <span class={`badge ${badge.cls}`}>{badge.label}</span>}
    {/* Bei Plakaten verdeckt das Etikett den Titel – Hinweis steht unten („Mehr & Fotos“) */}
    {hatFotos && !plakat && <span class="foto-tag">📷 Szenenfotos</span>}
    {/* Mit Plakat steht der Titel schon auf dem Bild – dann nur für Screenreader */}
    <h3 class:list={[{ 'sr-only': plakat }]} set:html={titel} />
    <span class:list={['sub', { 'sr-only': plakat }]}>{untertitel}</span>
  </a>
  <div class="foot">
    <span class="price">ab {preisAb} €</span>
    <a href={href}>{hatFotos ? 'Mehr & Fotos →' : 'Mehr →'}</a>
  </div>
</article>

<style>
  .poster.has-img {
    /* Seitenverhältnis der Plakate, damit unten nichts (Vorstellungszahl, Genre) abgeschnitten wird */
    aspect-ratio: 1075 / 1463;
    background-size: cover;
    background-position: center top;
  }
  /* Plakat unverändert zeigen (kein Abdunkeln), damit „Schon über … Vorstellungen“ lesbar bleibt */
  .poster.has-img::before { display: none; }
  .sr-only {
    position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px;
    overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; border: 0;
  }
  .foto-tag {
    position: absolute; top: 14px; left: 14px;
    font-size: 11.5px; font-weight: 800; letter-spacing: .06em; text-transform: uppercase;
    color: var(--cream); background: rgba(0, 0, 0, .5); border: 1px solid var(--line);
    padding: 4px 10px; border-radius: 999px;
  }
</style>
