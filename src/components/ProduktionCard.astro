---
import { typBadge, type Typ } from '../lib/format';
import { plakate, galerien } from '../lib/produktion-medien';

interface Props {
  id: string;
  titel: string;
  untertitel: string;
  typ: Typ;
  preisAb: number;
}
const { id, titel, untertitel, typ, preisAb } = Astro.props;
// „Theater“ steht nicht mehr auf den Plakaten (wir spielen ohnehin nur Theater) –
// nur abweichende Arten wie Familienstück oder Dinner bekommen ein Etikett.
const badge = typ === 'theater' ? null : typBadge(typ);
const plakat = plakate[id];
const hatFotos = Boolean(galerien[id]);
const href = `/programm/${id}`;
---

<article class="card">
  <a
    href={href}
    class:list={["poster", { "has-img": plakat }]}
    style={plakat ? `background-image:url('${plakat}')` : undefined}
    aria-label={`${titel.replace(/<[^>]+>/g, '')} – Details${hatFotos ? ' und Szenenfotos' : ''}`}
  >
    {!plakat && <span class="ph-tag">Plakat folgt</span>}
    {badge && <span class={`badge ${badge.cls}`}>{badge.label}</span>}
    {hatFotos && <span class="foto-tag">📷 Szenenfotos</span>}
    <h3 set:html={titel} />
    <span class="sub">{untertitel}</span>
  </a>
  <div class="foot">
    <span class="price">ab {preisAb} €</span>
    <a href={href}>{hatFotos ? 'Mehr & Fotos →' : 'Mehr →'}</a>
  </div>
</article>

<style>
  .poster.has-img {
    background-size: cover;
    background-position: center;
  }
  .poster.has-img::before {
    opacity: 1;
    background: linear-gradient(
      to top,
      rgba(28, 8, 20, .92) 0%,
      rgba(28, 8, 20, .5) 42%,
      rgba(28, 8, 20, .12) 100%
    );
  }
  .foto-tag {
    position: absolute; top: 14px; left: 14px;
    font-size: 11.5px; font-weight: 800; letter-spacing: .06em; text-transform: uppercase;
    color: var(--cream); background: rgba(0, 0, 0, .5); border: 1px solid var(--line);
    padding: 4px 10px; border-radius: 999px;
  }
</style>
