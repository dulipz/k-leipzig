---
const jahr = new Date().getFullYear();
---

<footer class="site">
  <div class="container">
    <div class="fgrid">
      <div>
        <div class="mark">KOMÖDIE <b>LEIPZIG</b></div>
        <p>Kleine Komödie Reuden</p>
        <p style="margin-top:10px"><b style="color:var(--amber)">Bei uns lachen Sie besser.</b></p>
      </div>
      <div>
        <h5>Entdecken</h5>
        <a href="/#programm">Programm</a>
        <a href="/spielplan">Spielplan &amp; Tickets</a>
        <a href="/#venue">Kleine Komödie</a>
        <a href="/#vermietung">Vermietung</a>
        <a href="/ensemble">Ensemble</a>
        <button type="button" class="dev-open" data-dev-open aria-haspopup="dialog">
          <img src="/images/dulip.jpg" alt="" width="22" height="22" loading="lazy" />
          Auch eine neue Website?
        </button>
      </div>
      <div>
        <h5>Rechtliches</h5>
        <a href="/impressum">Impressum</a>
        <a href="/datenschutz">Datenschutz</a>
        <a href="/agb">AGB</a>
        <a href="/kontakt">Kontakt</a>
      </div>
      <div>
        <h5>Kontakt</h5>
        <p>Dorfstraße 23<br />06766 Reuden an der Fuhne</p>
        <p>✉ kontakt@komoedie-leipzig.de</p>
        <p>☎ <a href="tel:+491791437331">0179 1437331</a></p>
        <p><a href="https://www.facebook.com/theaterdinner" target="_blank" rel="noopener" style="color:var(--amber)">Facebook</a></p>
      </div>
    </div>
    <div class="legal">
      <span>© {jahr} Komödie Leipzig · Irene Holzfurtner &amp; Mathias Engel</span>
      <span><a href="/impressum">Impressum</a><a href="/datenschutz">Datenschutz</a><a href="/agb">AGB</a></span>
    </div>
    <p class="dev">Entwickelt von <a href="https://codestadt.de/" target="_blank" rel="noopener">CODESTADT Digital GmbH</a></p>
  </div>
</footer>

<!-- Kleines Fenster „Auch eine neue Website?“ – öffnet sich per Klick auf den Link im Footer -->
<dialog class="dev-modal" id="dev-modal" aria-labelledby="dev-title">
  <button type="button" class="dev-close" data-dev-close aria-label="Schließen">×</button>
  <div class="dev-head">
    <img src="/images/dulip.jpg" alt="Dulip" width="52" height="52" loading="lazy" />
    <b id="dev-title">Auch eine neue Website?</b>
  </div>
  <p>Diese Seite hat Dulip entwickelt. Er hilft Ihnen gern bei Ihrer Website und betreut kleine und mittlere Unternehmen auch im IT-Support.</p>
  <a href="tel:+4915146159894">☎&nbsp;0151&nbsp;46159894</a>
  <a href="mailto:dulip.w@codestadt.de">✉&nbsp;dulip.w@codestadt.de</a>
</dialog>

<script>
  const devModal = document.getElementById('dev-modal') as HTMLDialogElement | null;
  if (devModal) {
    document.querySelectorAll('[data-dev-open]').forEach((b) =>
      b.addEventListener('click', () => {
        if (typeof devModal.showModal === 'function') devModal.showModal(); else devModal.setAttribute('open', '');
      })
    );
    const zu = () => (typeof devModal.close === 'function' ? devModal.close() : devModal.removeAttribute('open'));
    devModal.querySelector('[data-dev-close]')?.addEventListener('click', zu);
    // Klick neben das Fenster schließt es
    devModal.addEventListener('click', (e) => { if (e.target === devModal) zu(); });
  }
</script>

<style>
  footer.site .dev { margin: 14px 0 0; font-size: 12.5px; opacity: .75; text-align: center; }
  footer.site .dev a { display: inline; margin: 0; font-size: inherit; color: var(--cream-dim); text-decoration: underline; text-underline-offset: 2px; }
  footer.site .dev a:hover { color: var(--amber); }
  /* Link „Auch eine neue Website?“ unter „Entdecken“ */
  footer.site .dev-open { display: inline-flex; align-items: center; gap: 8px; margin-top: 14px; padding: 6px 12px 6px 6px; font: inherit; font-size: 13.5px; color: var(--cream-dim); background: rgba(255, 255, 255, .04); border: 1px solid var(--line); border-radius: 999px; cursor: pointer; transition: color .2s, border-color .2s; }
  footer.site .dev-open:hover, footer.site .dev-open:focus-visible { color: var(--amber); border-color: rgba(244, 161, 77, .5); }
  @media (max-width: 680px) { footer.site .dev-open { margin-bottom: 26px; } }
  footer.site .dev-open img { width: 22px; height: 22px; border-radius: 50%; object-fit: cover; filter: grayscale(1); }

  /* Kleines Fenster */
  .dev-modal { position: fixed; inset: 0; margin: auto; height: fit-content; width: min(340px, calc(100% - 32px)); padding: 22px 20px 18px; border: 1px solid var(--line); border-radius: 18px; background: var(--wine-deep, #2c0d20); color: var(--cream); box-shadow: 0 24px 60px -12px rgba(0, 0, 0, .7); }
  .dev-modal::backdrop { background: rgba(0, 0, 0, .55); backdrop-filter: blur(2px); }
  .dev-modal .dev-close { position: absolute; top: 8px; right: 10px; font-size: 24px; line-height: 1; color: var(--cream-dim); background: none; border: 0; cursor: pointer; padding: 4px 8px; }
  .dev-modal .dev-head { display: flex; align-items: center; gap: 12px; margin-bottom: 10px; padding-right: 20px; }
  .dev-modal img { width: 52px; height: 52px; border-radius: 50%; object-fit: cover; flex: none; filter: grayscale(1); }
  .dev-modal b { font-size: 16px; line-height: 1.25; }
  .dev-modal p { font-size: 14px; line-height: 1.55; color: var(--cream-dim); margin: 0 0 12px; }
  .dev-modal a { display: block; font-size: 14.5px; margin: 0 0 4px; color: var(--amber); white-space: nowrap; }
  .dev-modal a:hover { color: var(--amber-bright); }
  /* Rechtliche Links unten in einer Zeile (die allgemeine Footer-Regel macht Links sonst zu Blöcken) */
  footer.site .legal a { display: inline; margin: 0 0 0 18px; font-size: inherit; }
  @media (max-width: 680px) { footer.site .legal a { margin: 0; } }
</style>
