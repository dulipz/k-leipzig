---
// Schriften lokal ausgeliefert (kein Abruf bei Google – DSGVO)
import '@fontsource-variable/fraunces/opsz.css';
import '@fontsource-variable/fraunces/opsz-italic.css';
import '@fontsource-variable/libre-franklin/index.css';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import GutscheinModal from '../components/GutscheinModal.astro';

interface Props {
  title?: string;
  description?: string;
  /** Transparente Navigation über einem Vollbild-Hero (nur Startseite). */
  heroHeader?: boolean;
}

const {
  title = 'Komödie Leipzig — Kleine Komödie Reuden',
  description = 'Komödiantisches Theater in der Kleinen Komödie Reuden bei Bitterfeld-Wolfen – 80 Plätze und Theater-Bar. Bei uns lachen Sie besser. Eröffnung 13.03.2026.',
  heroHeader = false,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site).href;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'PerformingArtsTheater',
  name: 'Komödie Leipzig – Kleine Komödie Reuden',
  url: 'https://www.komoedie-leipzig.de',
  email: 'kontakt@komoedie-leipzig.de',
  address: {
    '@type': 'PostalAddress',
    streetAddress: 'Dorfstraße 23',
    postalCode: '06766',
    addressLocality: 'Reuden an der Fuhne',
    addressCountry: 'DE',
  },
};
---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="canonical" href={canonical} />
    <title>{title}</title>
    <meta name="description" content={description} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="de_DE" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} is:inline />
  </head>
  <body class:list={[{ "has-hero": heroHeader }]}>
    <div class="wrap">
      <Header />
      <main>
        <slot />
      </main>
      <Footer />
    </div>
    <GutscheinModal />
  </body>
</html>
