{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "k-leipzig",
  "compatibility_date": "2026-06-14",
  "compatibility_flags": ["nodejs_compat"],
  "main": "dist/_worker.js/index.js",
  "assets": {
    "binding": "ASSETS",
    "directory": "dist"
  },
  "observability": { "enabled": true }
}
